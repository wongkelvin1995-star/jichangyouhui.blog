---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlanTable from '../../components/PlanTable.astro';
import BrandMark from '../../components/BrandMark.astro';
import { ALL_BRANDS, getBrandBySlug } from '../../data/brands';
import { getPlansByBrand } from '../../data/plans';
import { buildBreadcrumbSchema, buildWebPageSchema } from '../../utils/schema';

export function getStaticPaths() {
  return ALL_BRANDS.map((b) => ({ params: { slug: b.slug } }));
}

const { slug } = Astro.params;
const brand = getBrandBySlug(slug!);
if (!brand) throw new Error(`Unknown brand slug: ${slug}`);

const brandPlans = getPlansByBrand(brand.slug);
const breadcrumbs = [
  { label: '首页', href: '/' },
  { label: '套餐对比', href: '/comparison/' },
  { label: `${brand.name}套餐价格` },
];

const title = `${brand.name}全部套餐价格明细、月均成本与每GB单价计算｜机场优惠`;
const description = `完整列出${brand.name}（${brand.englishName}）${brandPlans.length} 档套餐原价、有效折后价、每月流量额度、折合月均成本与每 GB 成本分析。`;

const schemas = [
  buildWebPageSchema({
    title,
    description,
    path: `/plans/${brand.slug}/`,
    dateModified: brand.lastUpdatedDate,
  }),
  buildBreadcrumbSchema(breadcrumbs),
];
---

<BaseLayout title={title} description={description} canonicalPath={`/plans/${brand.slug}/`} schemas={schemas}>
  <section class="bg-band-comparison py-10 sm:py-14 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-start gap-4">
          <BrandMark slug={brand.slug} name={brand.name} size="lg" />
          <div>
            <h1 class="text-2xl sm:text-4xl font-extrabold text-[#102343] mb-2">
              {brand.name} 全部套餐价格与成本表
            </h1>
            <p class="text-sm sm:text-base text-slate-600">
              价格记录日期：{brand.priceRecordDate} · 共 {brandPlans.length} 档套餐 · {brand.trafficResetSummary}
            </p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2.5 shrink-0">
          <a
            href={`/brands/${brand.slug}/`}
            class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white text-sm font-semibold text-[#102343] min-h-[44px] inline-flex items-center"
          >
            查看品牌深度页
          </a>
          <a
            href={`/coupons/${brand.slug}/`}
            class="px-4 py-2.5 rounded-xl bg-indigo-50 text-indigo-800 border border-indigo-200 text-sm font-semibold min-h-[44px] inline-flex items-center"
          >
            优惠码详情
          </a>
          <a
            href={brand.affLink}
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            class="px-4 py-2.5 rounded-xl bg-emerald-600 text-white text-sm font-semibold min-h-[44px] inline-flex items-center"
          >
            前往官网购买
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-10 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      {brand.priceConflictNote && (
        <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs sm:text-sm text-amber-900">
          <strong>版本差异提醒：</strong>{brand.priceConflictNote}
        </div>
      )}

      <PlanTable plans={brandPlans} showBrandColumn={false} />

      <div class="p-5 rounded-2xl bg-white border border-slate-200 text-xs sm:text-sm text-slate-600 space-y-2">
        <p><strong>倍率说明：</strong>{brand.multiplierSummary}</p>
        <p><strong>价格来源：</strong>{brand.priceSourceNote}</p>
        <p><strong>售后与变更：</strong>{brand.refundAndUpgradePolicy}</p>
      </div>
    </div>
  </section>
</BaseLayout>

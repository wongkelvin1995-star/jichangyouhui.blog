  <!-- 9. 机场购买知识（高价值原创新手与成本分析内容） -->
  <section class="py-12 sm:py-16 bg-white border-t border-slate-100 reveal-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('guides', (e) => !e.data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.data.slug ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const slug = entry.data.slug ?? entry.id;

const allGuides = await getCollection('guides', (e) => !e.data.draft);
const relatedGuides = allGuides
  .filter((g) => (g.data.slug ?? g.id) !== slug)
  .slice(0, 4)
  .map((g) => ({
    title: g.data.title,
    href: `/guides/${g.data.slug ?? g.id}/`,
    category: g.data.category,
    description: g.data.description,
  }));
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={`/guides/${slug}/`}
  category={entry.data.category}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  author={entry.data.author}
  headings={headings}
  relatedBrands={entry.data.relatedBrands}
  relatedArticlesData={relatedGuides}
  sources={entry.data.sources}
  faqs={entry.data.faqs}
  breadcrumbs={[
    { label: '首页', href: '/' },
    { label: '购买攻略', href: '/guides/' },
    { label: entry.data.title },
  ]}
>
  <Content />
</ArticleLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { buildBreadcrumbSchema, buildCollectionSchema } from '../../utils/schema';

const guides = (await getCollection('guides', (e) => !e.data.draft)).sort((a, b) =>
  b.data.publishDate.localeCompare(a.data.publishDate)
);

const breadcrumbs = [{ label: '首页', href: '/' }, { label: '购买攻略' }];
const title = '2026 机场购买攻略｜优惠码使用、新手注册与避坑指南｜机场优惠';
const description =
  '汇总机场购买前必须掌握的实用攻略：优惠码使用步骤、失效原因排查、新用户首单与续费差异、客户端兼容核查及退款边界。';

const schemas = [
  buildCollectionSchema({
    title,
    description,
    path: '/guides/',
    items: guides.map((g) => ({
      name: g.data.title,
      url: `/guides/${g.data.slug ?? g.id}/`,
    })),
  }),
  buildBreadcrumbSchema(breadcrumbs),
];
---

<BaseLayout title={title} description={description} canonicalPath="/guides/" schemas={schemas}>
  <section class="bg-band-hero py-10 sm:py-14 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#102343] mb-3">
        2026 机场购买攻略与实操指南
      </h1>
      <p class="text-sm sm:text-base text-slate-600 max-w-3xl leading-relaxed">
        从新手注册下单、优惠码填写校验、客户端选择到长期续费风险管理，用可核查的流程帮助您减少盲目试错成本。
      </p>
    </div>
  </section>

  <section class="py-12 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {guides.map((g) => {
          const slug = g.data.slug ?? g.id;
          return (
            <article class="bento-card p-6 flex flex-col justify-between gap-4">
              <div>
                <div class="flex items-center justify-between gap-2 text-xs mb-2.5">
                  <span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 font-semibold">
                    {g.data.category}
                  </span>
                  <time class="text-slate-400" datetime={g.data.publishDate}>
                    {g.data.publishDate}
                  </time>
                </div>
                <h2 class="text-lg font-bold text-[#102343] leading-snug mb-2">
                  <a href={`/guides/${slug}/`} class="hover:text-emerald-700">
                    {g.data.title}
                  </a>
                </h2>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{g.data.description}</p>
              </div>
              <a
                href={`/guides/${slug}/`}
                class="text-xs font-semibold text-[#102343] hover:text-emerald-700 pt-3 border-t border-slate-100"
              >
                阅读完整攻略 →
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

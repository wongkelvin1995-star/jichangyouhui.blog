---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { buildBreadcrumbSchema, buildCollectionSchema } from '../../utils/schema';

const articles = (await getCollection('articles', (e) => !e.data.draft)).sort((a, b) =>
  b.data.publishDate.localeCompare(a.data.publishDate)
);

const categories = Array.from(new Set(articles.map((a) => a.data.category)));
const breadcrumbs = [{ label: '首页', href: '/' }, { label: '深度文章' }];
const title = '2026 机场深度文章库｜品牌购买分析、套餐测算与专题指南｜机场优惠';
const description = `汇集 ${articles.length} 篇原创机场优惠专题、品牌深度解析、每 GB 成本计算、流量规划与客户端兼容指南。`;

const schemas = [
  buildCollectionSchema({
    title,
    description,
    path: '/articles/',
    items: articles.map((a) => ({
      name: a.data.title,
      url: `/articles/${a.data.slug ?? a.id}/`,
    })),
  }),
  buildBreadcrumbSchema(breadcrumbs),
];
---

<BaseLayout title={title} description={description} canonicalPath="/articles/" schemas={schemas}>
  <section class="bg-band-articles py-10 sm:py-14 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#102343] mb-3">
        深度专题与品牌分析文章库
      </h1>
      <p class="text-sm sm:text-base text-slate-600 max-w-3xl leading-relaxed">
        共收录 <strong>{articles.length}</strong> 篇结构化分析文章，覆盖全站套餐成本方法论、使用场景流量规划及重点机场品牌深度拆解。
      </p>

      <div class="flex flex-wrap gap-2 mt-6">
        <button
          type="button"
          data-art-cat="all"
          class="px-3.5 py-2 rounded-xl bg-[#102343] text-white text-xs font-semibold min-h-[38px]"
        >
          全部（{articles.length}）
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            data-art-cat={cat}
            class="px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-semibold min-h-[38px]"
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="py-12 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="articles-grid">
        {articles.map((art) => {
          const slug = art.data.slug ?? art.id;
          return (
            <article data-cat={art.data.category} class="bento-card p-5 flex flex-col justify-between gap-3">
              <div>
                <div class="flex items-center justify-between gap-2 text-xs mb-2.5">
                  <span class="px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 font-semibold">
                    {art.data.category}
                  </span>
                  <time class="text-slate-400" datetime={art.data.publishDate}>
                    {art.data.publishDate}
                  </time>
                </div>
                <h2 class="text-base font-bold text-[#102343] leading-snug mb-2">
                  <a href={`/articles/${slug}/`} class="hover:text-emerald-700">
                    {art.data.title}
                  </a>
                </h2>
                <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">{art.data.description}</p>
              </div>
              <a
                href={`/articles/${slug}/`}
                class="text-xs font-semibold text-[#102343] hover:text-emerald-700 pt-2 border-t border-slate-100"
              >
                阅读全文 →
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-art-cat]');
    const cards = document.querySelectorAll<HTMLElement>('#articles-grid article');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-art-cat') ?? 'all';
        buttons.forEach((b) => {
          const active = b === btn;
          b.className = active
            ? 'px-3.5 py-2 rounded-xl bg-[#102343] text-white text-xs font-semibold min-h-[38px]'
            : 'px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs font-semibold min-h-[38px]';
        });
        cards.forEach((c) => {
          if (target === 'all' || c.dataset.cat === target) c.classList.remove('hidden');
          else c.classList.add('hidden');
        });
      });
    });
  </script>
</BaseLayout>

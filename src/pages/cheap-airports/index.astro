---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlanTable from '../../components/PlanTable.astro';
import { getPlansByBudgetTier } from '../../data/plans';
import { buildBreadcrumbSchema, buildWebPageSchema } from '../../utils/schema';

const under10 = getPlansByBudgetTier('under10');
const tier10to20 = getPlansByBudgetTier('10to20');
const monthlyUnder20 = [...under10, ...tier10to20].filter((p) => p.plan.cycle === 'monthly');

const breadcrumbs = [{ label: '首页', href: '/' }, { label: '便宜机场与低预算推荐' }];
const title = '2026 便宜机场套餐筛选｜每月 10 元与 20 元以下真实报价对比｜机场优惠';
const description =
  '按真实价格筛选每月折合 ¥10 以下及 ¥10–¥20 区间高性价比机场套餐，明确区分「直接月付入门」与「需一次性年付预付」，助您控制预算。';

const schemas = [
  buildWebPageSchema({ title, description, path: '/cheap-airports/', dateModified: '2026-11-25' }),
  buildBreadcrumbSchema(breadcrumbs),
];
---

<BaseLayout title={title} description={description} canonicalPath="/cheap-airports/" schemas={schemas}>
  <section class="bg-band-hero py-10 sm:py-14 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#102343] mb-3">
        2026 便宜机场套餐筛选与预算指南
      </h1>
      <p class="text-sm sm:text-base text-slate-600 max-w-3xl leading-relaxed">
        低价方案通常分为两类：一是「年付轻量小包」（整年实付 ¥79–¥109，折合月均 ¥6.58–¥9.08）；二是「常规月付入门档」（含折扣后低至 ¥13.99–¥20/月）。本页严格依据真实价格筛选，不做无依据的口号推荐。
      </p>
    </div>
  </section>

  <section class="py-10 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div>
        <h2 class="text-2xl font-bold text-[#102343] mb-2">
          一、支持单月直接支付（无需年付预付）的 ¥20 以下月付套餐（{monthlyUnder20.length} 档）
        </h2>
        <p class="text-sm text-slate-600 mb-4">
          适合首次购买、希望把首单试错成本控制在 ¥20 以内的用户。其中部分套餐需在结账页输入对应优惠码生效。
        </p>
        <PlanTable plans={monthlyUnder20} />
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[#102343] mb-2">
          二、月均成本 ¥10 以下方案（均为年付小包，需整年一次支付）
        </h2>
        <p class="text-sm text-slate-600 mb-4">
          以下方案月均成本在 ¥6.58–¥10 之间，但需一次性付清全年费用（¥79–¥120），每月流量额度一般为 40GB–80GB。
        </p>
        <PlanTable plans={under10} />
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[#102343] mb-2">
          三、月均成本 ¥10–¥20 区间全周期方案（{tier10to20.length} 档）
        </h2>
        <PlanTable plans={tier10to20} />
      </div>
    </div>
  </section>
</BaseLayout>

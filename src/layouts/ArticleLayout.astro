---
import type { MarkdownHeading } from 'astro';
import type { BrandFaq } from '../types/airport';
import { getBrandBySlug } from '../data/brands';
import { getBrandMinMonthlyStats } from '../data/plans';
import { formatYuan } from '../utils/pricing';
import { buildBlogPostingSchema, buildBreadcrumbSchema, buildFaqSchema } from '../utils/schema';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  category: string;
  publishDate: string;
  updatedDate: string;
  author: string;
  headings: MarkdownHeading[];
  relatedBrands?: string[];
  relatedArticlesData?: { title: string; href: string; category: string; description: string }[];
  sources?: string[];
  faqs?: BrandFaq[];
  breadcrumbs: { label: string; href?: string }[];
}

const {
  title,
  description,
  canonicalPath,
  category,
  publishDate,
  updatedDate,
  author,
  headings,
  relatedBrands = [],
  relatedArticlesData = [],
  sources = [],
  faqs = [],
  breadcrumbs,
} = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const resolvedBrands = relatedBrands
  .map((slug) => getBrandBySlug(slug))
  .filter((b): b is NonNullable<typeof b> => Boolean(b));

const schemas: Record<string, unknown>[] = [
  buildBlogPostingSchema({
    title,
    description,
    path: canonicalPath,
    publishDate,
    updatedDate,
    author,
  }),
  buildBreadcrumbSchema(breadcrumbs),
];
const faqSchema = buildFaqSchema(faqs);
if (faqSchema) schemas.push(faqSchema);
---

<BaseLayout
  title={`${title}｜机场优惠`}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  publishedTime={publishDate}
  modifiedTime={updatedDate}
  schemas={schemas}
>
  <article class="bg-band-articles py-8 sm:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Main Reading Column (720-860px optimal) -->
        <div class="lg:col-span-8 max-w-[860px]">
          <header class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 mb-6 shadow-xs">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                {category}
              </span>
              <span class="text-xs text-slate-500">发布：{publishDate}</span>
              <span class="text-xs text-slate-500">更新：{updatedDate}</span>
              <span class="text-xs text-slate-500">作者：{author}</span>
            </div>

            <h1 class="text-2xl sm:text-3xl font-extrabold text-[#102343] leading-tight mb-4">
              {title}
            </h1>
            <p class="text-base text-slate-600 leading-relaxed bg-slate-50 rounded-xl p-4 border border-slate-100">
              {description}
            </p>
          </header>

          <!-- Mobile Collapsible TOC -->
          {tocHeadings.length > 0 && (
            <details class="lg:hidden bg-white rounded-2xl border border-slate-200 p-4 mb-6">
              <summary class="font-semibold text-sm text-[#102343] cursor-pointer min-h-[36px] flex items-center justify-between">
                <span>文章目录（点击展开/收起）</span>
                <span class="text-xs text-slate-500">{tocHeadings.length} 节</span>
              </summary>
              <nav aria-label="文章目录" class="mt-3 pt-3 border-t border-slate-100 space-y-1.5 text-sm">
                {tocHeadings.map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class={`block py-1 text-slate-600 hover:text-[#102343] ${
                      h.depth === 3 ? 'pl-4 text-xs' : 'font-medium'
                    }`}
                  >
                    {h.text}
                  </a>
                ))}
              </nav>
            </details>
          )}

          <!-- Prose Content -->
          <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-xs">
            <div class="prose prose-slate prose-article max-w-none">
              <slot />
            </div>

            <!-- Knowledge Tip Box -->
            <aside class="mt-8 p-5 rounded-xl bg-emerald-50/70 border border-emerald-200/80 text-sm text-slate-700">
              <p class="font-bold text-[#102343] mb-1">消费与核对提示</p>
              <p>
                本站涉及的套餐价格、优惠码比例与适用条件均源于整理日期的公开资料或用户提交档案，不代表实际测速结果。付款前请务必在对应品牌结算页面确认实付金额与当期使用条款；部分链接含推广参数，详情见
                <a href="/affiliate-disclosure/" class="text-emerald-800 underline font-medium">商业推广披露</a>。
              </p>
            </aside>
          </div>

          <!-- Related Brands -->
          {resolvedBrands.length > 0 && (
            <section class="mt-8 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8">
              <h2 class="text-xl font-bold text-[#102343] mb-4">本文涉及品牌入口</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {resolvedBrands.map((b) => {
                  const st = getBrandMinMonthlyStats(b);
                  const mainCode = b.coupons.find((c) => c.status !== 'historical');
                  return (
                    <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/70 flex flex-col justify-between gap-3">
                      <div>
                        <div class="flex items-center justify-between gap-2 mb-1">
                          <a href={`/brands/${b.slug}/`} class="font-bold text-[#102343] hover:text-emerald-700">
                            {b.name}（{b.englishName}）
                          </a>
                          {mainCode && (
                            <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold">
                              码：{mainCode.code}
                            </span>
                          )}
                        </div>
                        <p class="text-xs text-slate-600 line-clamp-2">{b.tagline}</p>
                        {st.lowestMonthly && (
                          <p class="text-xs font-medium text-slate-700 mt-1.5">
                            常规月付起：{formatYuan(st.lowestMonthly.metrics.effectivePayable)}/月（{st.lowestMonthly.plan.monthlyTrafficGB}GB）
                          </p>
                        )}
                      </div>
                      <div class="flex gap-2">
                        <a
                          href={`/brands/${b.slug}/`}
                          class="flex-1 text-center px-3 py-2 rounded-lg bg-white border border-slate-200 text-xs font-semibold text-[#102343] min-h-[38px] inline-flex items-center justify-center"
                        >
                          查看品牌页
                        </a>
                        <a
                          href={b.affLink}
                          target="_blank"
                          rel="sponsored nofollow noopener noreferrer"
                          class="flex-1 text-center px-3 py-2 rounded-lg bg-emerald-600 text-white text-xs font-semibold min-h-[38px] inline-flex items-center justify-center"
                        >
                          前往官网
                        </a>
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          )}

          <!-- Article FAQs -->
          {faqs.length > 0 && (
            <section class="mt-8 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8">
              <h2 class="text-xl font-bold text-[#102343] mb-4">常见问题解答</h2>
              <div class="space-y-3">
                {faqs.map((f) => (
                  <details class="rounded-xl border border-slate-200 p-4 bg-slate-50/50">
                    <summary class="font-semibold text-sm text-[#102343] cursor-pointer">{f.question}</summary>
                    <p class="mt-2.5 text-sm text-slate-600 leading-relaxed">{f.answer}</p>
                  </details>
                ))}
              </div>
            </section>
          )}

          <!-- Related Articles -->
          {relatedArticlesData.length > 0 && (
            <section class="mt-8 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8">
              <h2 class="text-xl font-bold text-[#102343] mb-4">相关延伸阅读</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {relatedArticlesData.map((art) => (
                  <a
                    href={art.href}
                    class="p-4 rounded-xl border border-slate-200 hover:border-emerald-300 bg-slate-50/60 transition-colors block"
                  >
                    <span class="text-[11px] font-semibold text-indigo-700">{art.category}</span>
                    <h3 class="font-bold text-sm text-[#102343] mt-1 mb-1.5">{art.title}</h3>
                    <p class="text-xs text-slate-600 line-clamp-2">{art.description}</p>
                  </a>
                ))}
              </div>
            </section>
          )}

          <!-- Sources & Correction -->
          <footer class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-5 text-xs text-slate-600 space-y-2">
            {sources.length > 0 && (
              <p>
                <strong class="text-slate-800">资料参考依据：</strong>
                {sources.join('；')}
              </p>
            )}
            <p>
              <strong class="text-slate-800">价格与规则纠错：</strong>
              若发现品牌价格调整或优惠码失效，欢迎通过
              <a href="/contact/" class="text-[#102343] underline font-medium">联系与纠错入口</a>
              反馈核实。
            </p>
          </footer>
        </div>

        <!-- Desktop Sticky TOC Sidebar -->
        <aside class="hidden lg:block lg:col-span-4 sticky top-24 space-y-5">
          {tocHeadings.length > 0 && (
            <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs">
              <h2 class="text-sm font-bold text-[#102343] mb-3 pb-2 border-b border-slate-100">
                本文目录
              </h2>
              <nav aria-label="桌面端文章目录" class="space-y-1.5 text-sm max-h-[60vh] overflow-y-auto">
                {tocHeadings.map((h) => (
                  <a
                    href={`#${h.slug}`}
                    class={`block py-1 text-slate-600 hover:text-emerald-700 transition-colors ${
                      h.depth === 3 ? 'pl-4 text-xs text-slate-500' : 'font-medium'
                    }`}
                  >
                    {h.text}
                  </a>
                ))}
              </nav>
            </div>
          )}

          <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-xs space-y-3">
            <h2 class="text-sm font-bold text-[#102343]">快捷直达</h2>
            <div class="space-y-2 text-sm">
              <a href="/coupons/" class="block px-3.5 py-2.5 rounded-xl bg-emerald-50 text-emerald-800 font-semibold hover:bg-emerald-100">
                19 家品牌优惠码中心 →
              </a>
              <a href="/comparison/" class="block px-3.5 py-2.5 rounded-xl bg-slate-50 text-[#102343] font-medium hover:bg-slate-100">
                全站套餐价格对比表 →
              </a>
              <a href="/cheap-airports/" class="block px-3.5 py-2.5 rounded-xl bg-slate-50 text-[#102343] font-medium hover:bg-slate-100">
                便宜与高性价比推荐 →
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

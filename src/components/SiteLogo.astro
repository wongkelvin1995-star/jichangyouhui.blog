---
interface Props {
  size?: number;
  dark?: boolean;
}
const { size = 34, dark = false } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="shrink-0"
>
  <rect
    x="2"
    y="6"
    width="36"
    height="28"
    rx="8"
    fill={dark ? '#1E3A5F' : '#102343'}
  />
  <!-- Coupon ticket side notches -->
  <circle cx="2" cy="20" r="4" fill={dark ? '#102343' : '#F8FAFC'} />
  <circle cx="38" cy="20" r="4" fill={dark ? '#102343' : '#F8FAFC'} />
  <!-- Perforation divider -->
  <line
    x1="15"
    y1="10"
    x2="15"
    y2="30"
    stroke="rgba(255,255,255,0.22)"
    stroke-width="1.5"
    stroke-dasharray="2.5 2.5"
  />
  <!-- Network link nodes + price tag geometry -->
  <path
    d="M21 15L28 15L32 20L28 25L21 25L21 15Z"
    stroke="#10B981"
    stroke-width="2"
    stroke-linejoin="round"
  />
  <circle cx="24.5" cy="20" r="1.75" fill="#10B981" />
  <circle cx="9.5" cy="15.5" r="2" fill="#6366F1" />
  <circle cx="9.5" cy="24.5" r="2" fill="#10B981" />
  <line x1="9.5" y1="17.5" x2="9.5" y2="22.5" stroke="#94A3B8" stroke-width="1.5" />
</svg>
